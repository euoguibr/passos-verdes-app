rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu(uid) { return logado() && request.auth.uid == uid; }
    function organizador() {
      return logado() && request.auth.token.email != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    // Conteúdo publicado pela equipe: todo mundo vê, só organizador mexe.
    match /eventos/{id}   { allow read: if true; allow write: if organizador(); }
    match /noticias/{id}  { allow read: if true; allow write: if organizador(); }
    match /desafios/{id}  { allow read: if true; allow write: if organizador(); }
    match /enquetes/{id}  { allow read: if true; allow write: if organizador(); }
    match /quiz/{id}      { allow read: if true; allow write: if organizador(); }
    match /projeto/{id}   { allow read: if true; allow write: if organizador(); }
    match /produtos/{id}  { allow read: if true; allow write: if organizador(); }
    match /banners/{id}   { allow read: if true; allow write: if organizador(); }

    // Clube de vantagens: só quem está logado vê os parceiros.
    match /parceiros/{id} { allow read: if logado(); allow write: if organizador(); }

    // Cada corredor: quem está logado vê todos (presença, enquetes), mas só altera o próprio.
    match /membros/{uid} {
      allow read: if logado();
      allow write: if eu(uid) && request.resource.data.size() < 20;
    }

    // Km lançados nos desafios: entram como "pendente"; só a organização aprova ou recusa.
    match /lancamentos/{id} {
      allow read: if logado();
      allow create: if eu(request.resource.data.uid)
        && request.resource.data.status == 'pendente'
        && request.resource.data.km is number
        && request.resource.data.km > 0 && request.resource.data.km <= 300
        && request.resource.data.keys().hasOnly(['uid','nome','desafio','km','link','status','criado']);
      allow update: if organizador();
      allow delete: if organizador() || (eu(resource.data.uid) && resource.data.status == 'pendente');
    }

    // Print da corrida: só o próprio corredor e a organização veem.
    match /provas/{id} {
      allow read: if organizador() || eu(resource.data.uid);
      allow create: if eu(request.resource.data.uid) && request.resource.data.keys().hasOnly(['uid','foto']);
      allow delete: if organizador() || eu(resource.data.uid);
    }

    // Pedidos da loja: o corredor cria o próprio; só a organização vê a lista e atualiza.
    match /pedidos/{id} {
      allow create: if eu(request.resource.data.uid) && request.resource.data.status == 'novo';
      allow read: if organizador() || eu(resource.data.uid);
      allow update, delete: if organizador();
    }

    // Celulares que ativaram os avisos: cada um registra o próprio; só o servidor lê a lista.
    match /dispositivos/{token} {
      allow create, update: if eu(request.resource.data.uid)
        && request.resource.data.keys().hasOnly(['uid','criado','atualizado','plataforma']);
      allow delete: if logado() && resource.data.uid == request.auth.uid;
      allow read: if false;
    }

    // Lista de organizadores: só se gerencia pelo console do Firebase.
    match /admins/{email} {
      allow read: if logado() && request.auth.token.email.lower() == email;
      allow write: if false;
    }
  }
}
